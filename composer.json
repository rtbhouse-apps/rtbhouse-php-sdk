{
    "name": "rtbhouse/sdk",
    "description": "RTB House SDK",
    "type": "library",
    "config": {
        "platform": {
            "php": "8.1"
        }
    },
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.5.0",
        "symfony/console": "^6.4",
        "symfony/filesystem": "^6.4",
        "symfony/lock": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "autoload": {
        "files": [
            "src/Auth.php",
            "src/ReportsApi.php"
        ],
        "classmap": [
            "src/ApiTokens/"
        ]
    },
    "bin": [
        "bin/api-tokens"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "RTB House Apps Team",
            "email": "apps@rtbhouse.com"
        }
    ],
    "scripts": {
        "test": "vendor/bin/phpunit tests"
    }
}
