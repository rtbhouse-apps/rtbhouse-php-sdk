#!/usr/bin/env php
<?php
declare(strict_types=1);

use RTBHouse\ReportsApi\ApiTokens\ConsoleApplication;

// The location of autoload.php depends on how the SDK was installed:
//  - as a Composer dependency, this script runs from vendor/rtbhouse/sdk/bin/
//  - as a local project (a working copy of this repository), vendor/ sits next to bin/.
$autoload = null;
foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $candidate) {
    if (is_file($candidate)) {
        $autoload = $candidate;
        break;
    }
}
if ($autoload === null) {
    fwrite(STDERR, "Cannot locate vendor/autoload.php. Run composer install.\n");
    exit(1);
}
require $autoload;

exit((new ConsoleApplication())->run());
