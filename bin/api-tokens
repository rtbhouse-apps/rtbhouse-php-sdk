#!/usr/bin/env php
<?php
declare(strict_types=1);

$autoload = null;
foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $candidate) {
    if (is_file($candidate)) {
        $autoload = $candidate;
        break;
    }
}
if ($autoload === null) {
    fwrite(STDERR, "Cannot locate vendor/autoload.php. Run composer install.\n");
    exit(1);
}
require $autoload;

use RTBHouse\ReportsApi\ApiTokens\InitJsonCommand;
use RTBHouse\ReportsApi\ApiTokens\KeepAliveJsonCommand;
use Symfony\Component\Console\Application;

$app = new Application('rtbhouse-php-sdk');
$app->add(new InitJsonCommand());
$app->add(new KeepAliveJsonCommand());
$app->run();
